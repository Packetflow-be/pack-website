---
// A named offer inside an existing page (data: src/data/offers.ts). The
// caller decides whether it is shown (showHeld); this component only marks a
// held section as a staging concept.
import Kicker from "./Kicker.astro";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import type { OfferSection } from "@/data/offers";

interface Props {
  offer: OfferSection;
}
const { offer } = Astro.props;
---

<section class="section offer" id={offer.id}>
  <div class="container">
    {offer.held && <p class="offer__held">Concept, alleen op staging: dit stuk staat nog niet op packetflow.be.</p>}
    <div class="section-head offer__head">
      <Kicker>{offer.kicker}</Kicker>
      <h2>{offer.title}</h2>
      <p class="lead">{offer.intro}</p>
    </div>

    <div class="offer__grid">
      <aside class="offer__quotes" aria-labelledby={`${offer.id}-herkenbaar`}>
        <p class="offer__quotes-title" id={`${offer.id}-herkenbaar`}>Herkenbaar?</p>
        <ul class="offer__symptoms">
          {offer.symptoms.map((line) => (
            <li>
              <Icon name="quote" size={16} class="offer__mark" />
              <span>{line}</span>
            </li>
          ))}
        </ul>
      </aside>
      <ul class="offer__features">
        {offer.features.map((f) => (
          <li class="offer__feature">
            <span class="offer__icon"><Icon name={f.icon} size={18} /></span>
            <div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <h3 class="offer__subhead">Hoe het werkt</h3>
    <ol class="steps steps--4 offer__steps">
      {offer.steps.map((step, i) => (
        <li class="step">
          <span class="step__num">{i + 1}</span>
          <div>
            <h4 class="step__title">{step.title}</h4>
            <p class="step__body">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>

    {offer.scope && (
      <p class="offer__scope"><Icon name="scale" size={16} /> <span>{offer.scope}</span></p>
    )}

    <div class="offer__cta">
      <p>{offer.cta.line}</p>
      <Button href="/contact" variant="primary" iconRight="arrow-right">{offer.cta.label}</Button>
    </div>

    {offer.sources && offer.sources.length > 0 && (
      <p class="offer__sources">
        Bronnen:{" "}
        {offer.sources.map((s, i) => (
          <>
            {i > 0 && " · "}
            <a href={s.href} rel="noopener" target="_blank">{s.label}</a>
          </>
        ))}
      </p>
    )}
  </div>
</section>

<style>
  .offer {
    background: var(--paper);
    border-top: 3px solid var(--orange-600);
    border-bottom: 1px solid var(--border-soft);
  }
  .offer__held {
    display: inline-block;
    margin: 0 0 var(--space-5);
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--warning-soft);
    color: var(--orange-800);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .offer__head .lead {
    max-width: 62ch;
  }
  .offer__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-7);
    align-items: start;
    margin-top: var(--space-6);
  }
  .offer__quotes {
    background: var(--cream);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .offer__quotes-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    color: var(--text-strong);
  }
  .offer__symptoms {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .offer__symptoms li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--text-strong);
  }
  .offer__symptoms :global(.offer__mark) {
    flex: none;
    margin-top: 4px;
    color: var(--orange-600);
  }
  .offer__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-6);
  }
  .offer__feature {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 12px;
    align-items: start;
  }
  .offer__icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--blue-50);
    color: var(--blue-700);
  }
  .offer__feature h3 {
    margin: 4px 0 4px;
    font-size: 1.0625rem;
  }
  .offer__feature p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-muted);
  }
  .offer__subhead {
    margin: var(--space-8) 0 var(--space-5);
    font-size: 1.375rem;
  }
  .offer__scope {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: var(--space-6) 0 0;
    padding: var(--space-4) var(--space-5);
    border-left: 3px solid var(--blue-700);
    background: var(--blue-50);
    border-radius: 8px;
    color: var(--text-body);
    max-width: 72ch;
  }
  .offer__scope :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--blue-700);
  }
  .offer__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-5);
    align-items: center;
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-soft);
  }
  .offer__cta p {
    margin: 0;
    flex: 1 1 320px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--text-strong);
  }
  .offer__sources {
    margin: var(--space-5) 0 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .offer__sources a {
    color: var(--text-link);
  }
  @media (max-width: 880px) {
    .offer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .offer__features {
      grid-template-columns: 1fr;
    }
  }
</style>
