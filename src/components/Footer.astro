---
import { site } from "@/data/site";
import { services } from "@/data/services";
import { sectors } from "@/data/sectors";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { url } from "@/lib/url";
const year = new Date().getFullYear();
const locals = services.flatMap((hub) => hub.locals);
---

<footer class="site-footer">
  <div class="container site-footer__top">
    <div class="site-footer__brand">
      <a href={url("/")} aria-label="Packetflow, naar de homepage">
        <Logo variant="full" size={30} onDark tagline />
      </a>
      <p class="site-footer__lead">
        {site.short} Vanuit {site.address.city}, voor heel {site.serviceArea}.
      </p>
      <div class="site-footer__contact">
        <a href={site.phoneHref}><Icon name="phone" size={16} /> {site.phone}</a>
        <a href={`mailto:${site.email}`}><Icon name="mail" size={16} /> {site.email}</a>
        <span><Icon name="map-pin" size={16} /> {site.address.postalCode} {site.address.city}, {site.address.region}</span>
        <span><Icon name="clock" size={16} /> {site.hours.label}</span>
        <span><Icon name="building-2" size={16} /> BTW {site.vatId}</span>
      </div>
    </div>

    <nav class="site-footer__col" aria-label="Diensten">
      <h2 class="site-footer__heading">
        <a href={url("/diensten")}>Diensten</a>
      </h2>
      <ul>
        {services.map((hub) => (
          <li>
            <a href={url(`/diensten/${hub.slug}`)}>{hub.title}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Voor wie">
      <h2 class="site-footer__heading">
        <a href={url("/sectoren")}>Voor wie?</a>
      </h2>
      <ul>
        {sectors.map((s) => (
          <li>
            <a href={url(`/sectoren/${s.slug}`)}>{s.navTitle}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="In de regio">
      <h2 class="site-footer__heading">In de regio</h2>
      <ul>
        {locals.map((local) => (
          <li>
            <a href={url(`/${local.slug}`)}>{local.title}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="site-footer__bar">
    <div class="container site-footer__bar-in">
      <span>{site.pillars} · © {year} {site.legalName}</span>
      <nav aria-label="Meer">
        <a href={url("/werkwijze")}>Werkwijze</a>
        <a href={url("/blog")}>Blog</a>
        <a href={url("/over-mij")}>Over mij</a>
        <a href={url("/lokale-it-partner-vs-groot-it-bedrijf")}>Lokaal vs. groot</a>
        <a href={url("/privacy")}>Privacy</a>
        <a href={url("/contact")}>Contact</a>
        <button type="button" data-cookie-settings>Cookievoorkeuren</button>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-10);
    background: var(--ink);
    color: var(--grey-300);
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--space-7);
    padding-block: var(--space-8) var(--space-7);
  }
  .site-footer__lead {
    margin-top: var(--space-4);
    max-width: 30ch;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--grey-400);
  }
  .site-footer__contact {
    margin-top: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .site-footer__contact a,
  .site-footer__contact span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--grey-300);
  }
  .site-footer__contact a:hover {
    color: var(--cream);
  }
  .site-footer__heading {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    color: var(--cream);
    margin: 0 0 var(--space-4);
  }
  .site-footer__heading a:hover {
    color: var(--orange-300);
  }
  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .site-footer__col li a {
    font-size: var(--text-sm);
    color: var(--grey-400);
  }
  .site-footer__col li a:hover {
    color: var(--cream);
  }
  .site-footer__bar {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .site-footer__bar-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-block: var(--space-5);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--grey-400);
  }
  .site-footer__bar-in nav {
    display: flex;
    /* Wraps, so the legal row stays inside the viewport on a phone instead of
       forcing the page to scroll sideways. */
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  /* The consent control is a button, not a link — it opens the banner rather
     than navigating. Styled to sit in the same row without looking different. */
  .site-footer__bar-in nav button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    cursor: pointer;
  }
  .site-footer__bar-in nav button:hover,
  .site-footer__bar-in nav a:hover {
    color: var(--cream);
  }

  /* keep in sync with --container-md in global.css */
  @media (max-width: 880px) {
    .site-footer__top {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }
  }
</style>
