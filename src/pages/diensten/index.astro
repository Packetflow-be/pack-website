---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaSection from "@/components/CtaSection.astro";
import Card from "@/components/Card.astro";
import Badge from "@/components/Badge.astro";
import Kicker from "@/components/Kicker.astro";
import Icon from "@/components/Icon.astro";
import Button from "@/components/Button.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { services } from "@/data/services";
import { breadcrumbs } from "@/lib/schema";
import { url } from "@/lib/url";

const crumbs: [string, string][] = [
  ["Home", "/"],
  ["Diensten", "/diensten"],
];
const jsonLd = breadcrumbs(crumbs);

// The projects first, then the beheer layer that keeps every one of them
// running (vault: pf-solutions-map, "project, then recurring").
const beheer = services.find((s) => s.slug === "it-beheer-support")!;
const projects = services.filter((s) => s.slug !== beheer.slug);
const allLocals = services.flatMap((s) => s.locals);
---

<BaseLayout
  title="Diensten: van verhuizing tot beheer"
  description="Oplossingen voor een benoemd probleem: een kantoorverhuizing, een beveiligde praktijk, Microsoft 365, gastenwifi, eigen bedrijfssoftware en het beheer daarna."
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="container page-hero__in">
      <Breadcrumbs items={crumbs} />
      <Kicker>Diensten</Kicker>
      <h1>Een oplossing voor een benoemd probleem</h1>
      <p class="lead page-hero__lead">
        U koopt geen pakket waarvan u de helft niet gebruikt. U kiest de
        oplossing voor het probleem dat u vandaag heeft. Eerst als project met
        een vaste prijs, daarna blijft het draaien met Packetflow Beheer.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="sr-only">Oplossingen</h2>
      <div class="svc-grid">
        {
          projects.map((hub) => (
            <Card class="svc-hub">
              <span class="svc-hub__icon">
                <Icon name={hub.icon} size={22} color="#fff" />
              </span>
              <Badge tone="blue">{hub.audience}</Badge>
              <h3 class="svc-hub__title">
                <a href={url(`/diensten/${hub.slug}`)}>{hub.title}</a>
              </h3>
              <p class="svc-hub__desc">{hub.tagline}</p>
              <a href={url(`/diensten/${hub.slug}`)} class="svc-hub__more">
                Meer over {hub.navTitle.toLowerCase()} <Icon name="arrow-right" size={15} />
              </a>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container beheer">
      <div>
        <Kicker>Onder alles</Kicker>
        <h2 class="beheer__title">{beheer.solution}</h2>
        <p class="beheer__lead">{beheer.description}</p>
        <Button href={`/diensten/${beheer.slug}`} variant="secondary" iconRight="arrow-right">
          Uit welke diensten u kiest
        </Button>
      </div>
      {
        allLocals.length > 0 && (
          <div class="svc-locals">
            <span class="kicker">In uw regio</span>
            <ul>
              {allLocals.map((local) => (
                <li>
                  <a href={url(`/${local.slug}`)}>
                    <Icon name="map-pin" size={15} color="var(--orange-700)" />
                    {local.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <CtaSection />
</BaseLayout>

<style>
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }
  /* `.svc-hub` is the Card component's root, so it carries Card's scope id,
     not this page's. Target it with :global(). */
  .svc-grid :global(.svc-hub) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .svc-hub__icon {
    width: 46px;
    height: 46px;
    border-radius: var(--radius-md);
    background: var(--ink);
    display: grid;
    place-content: center;
    margin-bottom: var(--space-2);
  }
  .svc-hub__title {
    font-size: var(--text-xl);
    margin: 0;
  }
  .svc-hub__title a:hover {
    color: var(--primary);
  }
  .svc-hub__desc {
    color: var(--text-muted);
    max-width: 60ch;
  }
  .svc-hub__more {
    margin-top: auto;
    padding-top: var(--space-2);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    color: var(--primary);
  }

  .beheer {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-7);
    align-items: start;
  }
  .beheer__title {
    font-size: var(--text-2xl);
    margin: var(--space-3) 0 var(--space-4);
  }
  .beheer__lead {
    color: var(--text-body);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
    margin-bottom: var(--space-5);
  }
  .svc-locals {
    background: var(--surface-sunken);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }
  .svc-locals ul {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .svc-locals a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--text-body);
  }
  .svc-locals a:hover {
    color: var(--text-strong);
  }
  /* keep in sync with --container-md in global.css */
  @media (max-width: 880px) {
    .svc-grid,
    .beheer {
      grid-template-columns: 1fr;
    }
  }
</style>
