---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaSection from "@/components/CtaSection.astro";
import Partners from "@/components/Partners.astro";
import Reviews from "@/components/Reviews.astro";
import Button from "@/components/Button.astro";
import Badge from "@/components/Badge.astro";
import Card from "@/components/Card.astro";
import Kicker from "@/components/Kicker.astro";
import Icon from "@/components/Icon.astro";
import Portrait from "@/components/Portrait.astro";
import { site } from "@/data/site";
import { services } from "@/data/services";
import { sectors } from "@/data/sectors";
import { url } from "@/lib/url";

// The LocalBusiness/Organization node is emitted site-wide by BaseLayout, so
// the homepage needs no page-specific JSON-LD of its own.

// Illustrative status card: the kind of thing the monthly report shows.
const status = [
  ["Netwerk & segmentatie", "network", "success", "In orde"],
  ["Back-up", "database", "success", "Hersteltest geslaagd"],
  ["Toestellen", "shield-check", "blue", "24/7 bewaakt"],
  ["Werkstation onthaal", "monitor", "warning", "Update gepland"],
];

// Selling-point pillars (vault: packetflow-strategy, trust signals in order:
// a plan first, the as-built handed over, one person who knows you).
const pillars = [
  ["clipboard-check", "Eerst een plan", "Voor ik iets aanraak, ligt er een plan: wat er is, wat er moet veranderen en in welke volgorde. Zo weet u vooraf waar u aan toe bent."],
  ["file-text", "Gedocumenteerd opgeleverd", "Netwerkschema, configuratie en toegang: u krijgt alles in handen. Wie na mij komt, begint niet bij nul."],
  ["handshake", "Eén vast aanspreekpunt", "Altijd dezelfde persoon, die uw zaak en uw mensen kent. Geen wisselende technici bij uw dossiers."],
];

// The two clocks (vault: pf-service-terms). What runs 24/7 is the vendors'
// staffed security centres; the human answer is Louis, within his hours.
const clocks = [
  ["shield-check", "Toestellen", "success", "24/7 bewaakt"],
  ["user-check", "Microsoft 365-accounts", "success", "24/7 bewaakt"],
  ["database", "Hersteltest back-up", "blue", "2× per jaar"],
  ["clock", "Opvolging door Louis", "blue", "ma–vr avond · za voormiddag"],
];

const howSteps = [
  ["Kennismaking", "Een gesprek van 30 minuten, bij u of via telefoon. Gratis."],
  ["Plan en offerte", "Na een bezoek ter plaatse: een vaste prijs voor het project en een maandprijs per eenheid voor het beheer."],
  ["Oplevering", "Alles gedocumenteerd in uw handen. U blijft eigenaar van alles, ook van uw Microsoft 365."],
  ["Beheer", "Bewaakt en bijgewerkt, met elke maand één pagina rapport over al uw diensten samen."],
];
---

<BaseLayout title={site.name} description={site.description}>
  {/* ---- Hero ---- */}
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <Badge tone="orange" dot>Enterprise-engineering op KMO-schaal</Badge>
        <h1 class="hero__title">
          <span class="hero__hallo">Hallo,</span><br />
          IT voor bedrijven waar stilstand geld kost
        </h1>
        <span class="rule hero__rule"></span>
        <p class="lead hero__lead">
          Kantoor én productie onder één plan. Netwerk, segmentatie, geteste
          back-ups, geregelde toegang. Gedocumenteerd opgeleverd, en u blijft
          eigenaar van alles.
        </p>
        <div class="hero__actions">
          <Button href="/contact" variant="primary" size="lg" iconRight="arrow-right">
            Vrijblijvend kennismaken
          </Button>
          <Button href={site.phoneHref} variant="secondary" size="lg" iconLeft="phone">
            Bel mij
          </Button>
        </div>
      </div>

      <div>
        <Card raised padded={false}>
          <div class="statuscard__head">
            <span class="statuscard__title">Maandrapport · voorbeeldkantoor</span>
            <Badge tone="success" dot>Operationeel</Badge>
          </div>
          <div class="statuscard__body">
            {
              status.map(([name, icon, tone, val]) => (
                <div class="statusrow">
                  <span class="statusrow__icon">
                    <Icon name={icon} size={17} color="var(--blue-700)" />
                  </span>
                  <span class="statusrow__name">{name}</span>
                  <Badge tone={tone as any}>{val}</Badge>
                </div>
              ))
            }
            <p class="statuscard__note">
              <Icon name="eye" size={14} /> Illustratief voorbeeld van wat u elke maand op één pagina krijgt.
            </p>
          </div>
        </Card>
      </div>
    </div>
  </section>

  {/* ---- Pillars ---- */}
  <section class="section pillars">
    <div class="container">
      <Kicker>Waarom Packetflow</Kicker>
      <h2 class="section__title">De degelijkheid van een groot IT-team, op maat van een KMO</h2>
      <div class="grid-3">
        {
          pillars.map(([icon, title, body], i) => (
            <Card accent={i === 1} class="pillar">
              <span class="pillar__icon">
                <Icon name={icon} size={22} color="#fff" />
              </span>
              <h3 class="pillar__title">{title}</h3>
              <p class="pillar__body">{body}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---- Solutions ---- */}
  <section class="section services" id="diensten">
    <div class="container">
      <div class="services__head">
        <div>
          <Kicker>Diensten</Kicker>
          <h2 class="section__title section__title--flush">
            Een oplossing voor een benoemd probleem
          </h2>
        </div>
        <Badge tone="blue">Eerst een project, daarna beheer</Badge>
      </div>
      <div class="svc-grid">
        {
          services.map((hub) => (
            <a href={url(`/diensten/${hub.slug}`)} class="svc">
              <Icon name={hub.icon} size={24} color="var(--orange-700)" />
              <h3 class="svc__title">{hub.title}</h3>
              <p class="svc__body">{hub.tagline}</p>
            </a>
          ))
        }
      </div>
      <div class="services__cta">
        <Button href="/diensten" variant="secondary" iconRight="arrow-right">
          Bekijk alle diensten
        </Button>
      </div>
    </div>
  </section>

  {/* ---- Who ---- */}
  <section class="section who">
    <div class="container">
      <Kicker>Voor wie</Kicker>
      <h2 class="section__title">Bedrijven van 2 tot 20 mensen, zonder eigen IT-afdeling</h2>
      <ul class="who__list">
        {
          sectors.map((s) => (
            <li>
              <a href={url(`/sectoren/${s.slug}`)} class="who__item">
                <span class="who__icon"><Icon name={s.icon} size={20} /></span>
                <span>
                  <span class="who__title">{s.navTitle}</span>
                  <span class="who__body">{s.tagline}</span>
                </span>
                <Icon name="arrow-right" size={16} class="who__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ---- The two clocks ---- */}
  <section class="section clocks" id="beveiliging">
    <div class="container hero__grid">
      <div>
        <Kicker>Dag en nacht, eerlijk gezegd</Kicker>
        <h2 class="clocks__title">Wat 24 uur op 24 draait, en wat niet</h2>
        <span class="rule clocks__rule"></span>
        <p class="lead clocks__lead">
          Uw toestellen en Microsoft 365-accounts worden dag en nacht bewaakt
          door een bemand beveiligingscentrum (Huntress en Petra Security). Dat
          spoort een aanval op en dampt die in, zonder op mij te wachten.
        </p>
        <p class="clocks__text">
          Een menselijk antwoord van mij is dat niet: de opvolging, de uitleg en
          het herstel gebeuren {site.hours.phrase}. Elke melding wordt uiterlijk
          de volgende werkdag bevestigd. Liever een smalle belofte die klopt, dan
          een ruime die ik niet waarmaak.
        </p>
        <div class="clocks__actions">
          <Button href="/werkwijze" variant="secondary" iconRight="arrow-right">
            Zo werk ik
          </Button>
        </div>
      </div>

      <Card raised padded={false}>
        <div class="statuscard__head">
          <span class="statuscard__title">Twee klokken</span>
          <Badge tone="success" dot>Actief</Badge>
        </div>
        <div class="statuscard__body">
          {
            clocks.map(([icon, name, tone, val]) => (
              <div class="statusrow">
                <span class="statusrow__icon">
                  <Icon name={icon} size={17} color="var(--blue-700)" />
                </span>
                <span class="statusrow__name">{name}</span>
                <Badge tone={tone as any}>{val}</Badge>
              </div>
            ))
          }
          <p class="statuscard__note">
            <Icon name="eye" size={14} /> De bewaking is van de leveranciers, de opvolging van mij.
          </p>
        </div>
      </Card>
    </div>
  </section>

  {/* ---- How ---- */}
  <section class="section how">
    <div class="container">
      <Kicker>Zo werk ik</Kicker>
      <h2 class="section__title">Van eerste gesprek tot beheer</h2>
      <ol class="steps steps--4">
        {
          howSteps.map(([title, body], i) => (
            <li class="step">
              <span class="step__num">{i + 1}</span>
              <div>
                <h3 class="step__title">{title}</h3>
                <p class="step__body">{body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="how__more">
        <a href={url("/werkwijze")}>Alles over de werkwijze, de prijsopbouw en de bereikbaarheid <Icon name="arrow-right" size={15} /></a>
      </p>
    </div>
  </section>

  {/* ---- About Louis ---- */}
  <section class="about" id="over-mij">
    <div class="container about__inner">
      <Kicker color="var(--orange-300)">Over mij</Kicker>
      <blockquote class="about__quote">
        “Ik ben Louis Declerck uit Jabbeke. Ik bouw de IT van kleine bedrijven
        zoals een groot bedrijf het zou doen: met een plan, gedocumenteerd,
        beveiligd en herstelbaar. En u krijgt alle documentatie in handen.”
      </blockquote>
      <div class="about__person">
        <Portrait src="/images/louis.jpg" alt="Louis Declerck" class="about__avatar" />
        <div>
          <div class="about__name">Louis Declerck</div>
          <div class="about__meta">Packetflow · Jabbeke, West-Vlaanderen</div>
        </div>
        <a href={url("/over-mij")} class="about__link">Lees meer <Icon name="arrow-right" size={15} /></a>
      </div>
    </div>
  </section>

  <Partners />

  <Reviews />

  <CtaSection />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    background: var(--cream);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
    padding-block: var(--space-9);
  }
  .hero__title {
    font-size: clamp(2.125rem, 4.4vw, 3.25rem);
    line-height: 1.12;
    margin: 20px 0 0;
    /* italic ascenders/descenders need a hair of room so nothing clips */
    padding-block: 0.06em;
  }
  .hero__hallo {
    font-style: italic;
    font-weight: var(--fw-medium);
  }
  .hero__rule {
    margin: 28px 0 22px;
  }
  .hero__lead {
    max-width: 46ch;
  }
  .hero__actions {
    display: flex;
    gap: var(--space-3);
    margin-top: 28px;
    flex-wrap: wrap;
  }

  /* Status card (shared shape: hero + ai) */
  .statuscard__head {
    padding: 18px 20px;
    border-bottom: 1px solid var(--border-soft);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .statuscard__title {
    font-family: var(--font-sans);
    font-weight: var(--fw-semibold);
    font-size: var(--text-sm);
    color: var(--text-strong);
  }
  .statuscard__body {
    padding: 8px 20px 18px;
  }
  .statusrow {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--border-soft);
    font-variant-numeric: tabular-nums;
  }
  .statusrow__icon {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    background: var(--blue-50);
    display: grid;
    place-content: center;
    flex: none;
  }
  .statusrow__name {
    flex: 1;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    color: var(--text-strong);
  }
  .statuscard__note {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 14px;
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  /* Section helpers */
  .section__title {
    font-size: var(--text-2xl);
    margin: 12px 0 40px;
  }
  .section__title--flush {
    margin-bottom: 0;
  }
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .pillars {
    background: var(--paper);
  }
  .pillar {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pillar__icon {
    width: 46px;
    height: 46px;
    border-radius: var(--radius-md);
    background: var(--ink);
    display: grid;
    place-content: center;
  }
  .pillar__title {
    font-size: var(--text-lg);
    margin: 0;
  }
  .pillar__body {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* Services */
  .services {
    background: var(--cream);
  }
  .services__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 40px;
  }
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border-soft);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .svc {
    background: var(--paper);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: background var(--dur-base) var(--ease-out);
  }
  .svc:hover {
    background: var(--cream);
  }
  .svc__title {
    font-family: var(--font-sans);
    font-weight: var(--fw-semibold);
    font-size: var(--text-md);
    color: var(--text-strong);
  }
  .svc__body {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-muted);
  }
  .services__cta {
    margin-top: 32px;
  }

  /* The two clocks */
  .clocks {
    background: var(--cream);
  }
  /* The grid reuses the hero layout; the section already carries the
     vertical padding, so drop the hero's own. */
  .clocks .hero__grid {
    padding-block: 0;
  }
  .clocks__title {
    font-size: var(--text-2xl);
    line-height: 1.12;
    margin: 12px 0 0;
  }
  .clocks__rule {
    width: 64px;
    margin: 22px 0;
  }
  .clocks__lead,
  .clocks__text {
    max-width: 50ch;
  }
  .clocks__text {
    margin-top: var(--space-4);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-body);
  }
  .clocks__actions {
    margin-top: 28px;
  }

  /* Who */
  .who {
    background: var(--paper);
    border-block: 1px solid var(--border-soft);
  }
  .who__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3) var(--space-5);
  }
  .who__item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--surface-raised);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .who__item:hover {
    border-color: var(--orange-300);
    box-shadow: var(--shadow-sm);
  }
  .who__icon {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--blue-50);
    color: var(--blue-700);
    display: grid;
    place-content: center;
  }
  .who__title {
    display: block;
    font-family: var(--font-sans);
    font-weight: var(--fw-semibold);
    font-size: var(--text-base);
    color: var(--text-strong);
  }
  .who__body {
    display: block;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--text-muted);
  }
  .who__item :global(.who__arrow) {
    margin-left: auto;
    flex: none;
    color: var(--primary);
  }

  /* How */
  .how {
    background: var(--paper);
    border-top: 1px solid var(--border-soft);
  }
  .how__more {
    margin-top: var(--space-6);
  }
  .how__more a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    color: var(--primary);
  }

  /* About */
  .about {
    background: var(--ink);
  }
  .about__inner {
    max-width: var(--container-md);
    padding-block: var(--space-9);
  }
  .about__quote {
    margin: 24px 0 0;
    padding: 0;
    border: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: var(--fw-medium);
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    line-height: 1.4;
    color: var(--cream);
    letter-spacing: -0.01em;
  }
  .about__person {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 32px;
  }
  .about__avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    flex: none;
    --portrait-mono: var(--text-base);
  }
  .about__name {
    font-family: var(--font-sans);
    font-weight: var(--fw-semibold);
    font-size: var(--text-base);
    color: var(--cream);
  }
  .about__meta {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--grey-400);
  }
  .about__link {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    color: var(--orange-300);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .about__link:hover {
    color: var(--orange-100);
  }

  /* keep in sync with --container-md in global.css */
  @media (max-width: 880px) {
    .hero__grid,
    .grid-3,
    .svc-grid,
    .who__list {
      grid-template-columns: 1fr;
    }
    .svc-grid {
      gap: 1px;
    }
  }
  @media (max-width: 560px) {
    .about__link {
      margin-left: 0;
      width: 100%;
    }
    .about__person {
      flex-wrap: wrap;
    }
  }
</style>
