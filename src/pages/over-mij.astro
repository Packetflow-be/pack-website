---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaSection from "@/components/CtaSection.astro";
import Card from "@/components/Card.astro";
import Kicker from "@/components/Kicker.astro";
import Icon from "@/components/Icon.astro";
import Button from "@/components/Button.astro";
import Portrait from "@/components/Portrait.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { site } from "@/data/site";
import { services } from "@/data/services";
import { sectors } from "@/data/sectors";
import { breadcrumbs, ORG_ID } from "@/lib/schema";

const crumbs: [string, string][] = [
  ["Home", "/"],
  ["Over mij", "/over-mij"],
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: site.owner,
    jobTitle: "Oprichter",
    worksFor: { "@id": ORG_ID },
    homeLocation: { "@type": "Place", name: `${site.address.city}, ${site.address.region}` },
  },
  breadcrumbs(crumbs),
];

const principles = [
  ["file-text", "Documentatie als standaard", "Netwerkschema's, configuraties en toegang: bewaard en in uw handen, zodat een andere IT'er morgen verder kan zonder bij nul te beginnen."],
  ["scale", "Eerlijk advies, ook tegen mijn omzet in", "Werkt uw setup goed genoeg? Dan zeg ik dat. Heeft u iets niet nodig? Dan verkoop ik het niet."],
  ["unlock", "U zit nooit vast", "Geen minimale looptijd, één maand opzeg. Uw Microsoft 365-omgeving en uw gegevens staan op uw naam. U zit nooit vast, ook niet aan mij."],
  ["map-pin", "Ter plaatse én op afstand", "Installaties: ik kom langs. Configuratie en mailproblemen: meestal op afstand, en dat is sneller voor u."],
  ["badge-check", "Licenties via mij", "Microsoft 365-licenties koopt u via Packetflow, als aparte lijn op de factuur. Eén aanspreekpunt voor de licentie en het beheer."],
  ["users", "Samenwerking met collega's", "Voor stroomwerken werk ik samen met elektriciens. Wat ik niet zelf kan, verwijs ik eerlijk door. Geen beloftes die ik niet kan waarmaken."],
];

const meaning = [
  `Ik werk voor mijn klanten ${site.hours.phrase}: ${site.hours.label}.`,
  "Elke melding wordt uiterlijk de volgende werkdag bevestigd. Overdag ben ik meestal niet bereikbaar.",
  "Uw toestellen en Microsoft 365-accounts worden intussen dag en nacht bewaakt door een beveiligingscentrum dat zelf ingrijpt.",
  "Ik kies klanten zorgvuldig. Geen tien dossiers tegelijk, geen weken wachten op een antwoord.",
  "Ik kom langs wanneer het u past. Zaakvoerders en bestuurders zijn overdag met hun eigen zaak bezig.",
];

const firstContact = [
  ["U vertelt kort wat u zoekt", "Een verhuizing, een Peppol-deadline, een vragenlijst van een klant over cyberveiligheid, of gewoon: ik weet niet waar te beginnen."],
  ["U krijgt een eerlijk antwoord", "Of ik kan helpen, of niet, of u beter ergens anders zit. Geen verkooppraatje en geen automatisch ingeplande 'ontdekkingsgesprekken'."],
  ["Past het?", "Dan plannen we een vrijblijvend bezoek ter plaatse. Pas als u akkoord bent met een offerte begint het echte werk."],
];

// Plain, factual "feiten over Packetflow" block. Deliberately dull and
// extractable: founder, location, services, service area and company number
// in one place, so search engines and AI assistants pick up the core facts
// reliably. Keep it factual and in line with data/site.ts.
const facts: { term: string; detail: string; href?: string }[] = [
  { term: "Oprichter", detail: site.owner },
  { term: "Onderneming", detail: "Packetflow, eenmanszaak" },
  { term: "Wat Packetflow doet", detail: site.boilerplate },
  {
    term: "Thuisbasis",
    detail: `${site.address.street}, ${site.address.postalCode} ${site.address.city} (${site.address.region})`,
  },
  {
    term: "Werkgebied",
    detail:
      "West-Vlaanderen, onder meer Brugge, Oostende, Knokke-Heist, Blankenberge, Zedelgem en Oostkamp. Voor een afgebakend project ook daarbuiten.",
  },
  { term: "Diensten", detail: services.map((s) => s.title).join(", ") + "." },
  { term: "Voor wie", detail: sectors.map((s) => s.navTitle).join(", ") + "." },
  { term: "Bereikbaarheid", detail: `${site.hours.label}. Zondag en feestdagen zijn geen werkdagen.` },
  { term: "Ondernemingsnummer", detail: site.companyNumber },
  { term: "BTW", detail: site.vatId },
  { term: "Telefoon", detail: site.phone, href: site.phoneHref },
  { term: "E-mail", detail: site.email, href: `mailto:${site.email}` },
  { term: "Support (klanten)", detail: site.supportEmail, href: `mailto:${site.supportEmail}` },
];
---

<BaseLayout
  title="Over mij: Louis Declerck, Packetflow"
  description="Ik ben Louis Declerck, oprichter van Packetflow. Geen tussenpersoon, geen wisselend team: u krijgt mij persoonlijk, vanuit Jabbeke, West-Vlaanderen."
  jsonLd={jsonLd}
>
  {/* Hero */}
  <section class="page-hero">
    <div class="container page-hero__in about-hero">
      <div>
        <Breadcrumbs items={crumbs} />
        <Kicker>Over mij</Kicker>
        <h1>Hallo, ik ben Louis!</h1>
        <div class="prose about-hero__intro">
          <p>
            Ik ben de oprichter van Packetflow en de persoon die uw IT in handen
            krijgt. Geen tussenpersoon, geen wisselend team, geen junior met mijn
            naam op de offerte.
          </p>
          <p>
            Overdag werk ik als netwerkspecialist in een professionele
            IT-omgeving. Die aanpak breng ik naar kleine bedrijven: eerst een
            plan, dan het werk, en alles gedocumenteerd in uw handen.
          </p>
        </div>
        <div class="page-hero__actions">
          <Button href="/contact" variant="primary" iconRight="send">Stuur me een bericht</Button>
        </div>
      </div>
      <div class="about-hero__photo">
        <Portrait src="/images/louis.jpg" alt="Louis Declerck, oprichter van Packetflow" class="about-portrait" />
        <span class="about-hero__cap">Louis Declerck · Jabbeke</span>
      </div>
    </div>
  </section>

  {/* When I'm reachable, and why */}
  <section class="section">
    <div class="container about-avail">
      <div class="prose">
        <Kicker>Eerlijk verhaal</Kicker>
        <h2 class="about-h2">Wanneer ik bereikbaar ben, en waarom</h2>
        <p>
          Een vraag die soms terugkomt: "Hoe combineer je dat met je werk
          overdag?" Eerlijk antwoord: met vaste uren en afspraken die ik ook
          kan waarmaken.
        </p>
        <p>
          Ik beloof u liever minder en houd me eraan, dan meer en maak het niet
          waar. Dat bepaalt ook voor wie ik wel en niet de juiste IT-partner
          ben: heeft u overdag iemand nodig die binnen het uur ter plaatse is, dan
          zeg ik u dat eerlijk.
        </p>
      </div>
      <Card class="about-meaning">
        <h3 class="about-meaning__title">Wat het betekent voor u</h3>
        <ul class="checklist">
          {
            meaning.map((m) => (
              <li>
                <span class="check"><Icon name="check" size={14} /></span>
                <span>{m}</span>
              </li>
            ))
          }
        </ul>
      </Card>
    </div>
  </section>

  {/* Hoe ik werk */}
  <section class="section band">
    <div class="container">
      <div class="section-head">
        <Kicker>Hoe ik werk</Kicker>
        <h2>Een paar principes waar u mij aan mag houden</h2>
      </div>
      <div class="grid-cards about-work__grid">
        {
          principles.map(([icon, title, body]) => (
            <Card class="feature">
              <span class="feature__icon"><Icon name={icon} size={20} /></span>
              <h3>{title}</h3>
              <p>{body}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  {/* Praktijkcase */}
  <section class="section">
    <div class="container about-case">
      <Kicker>Een voorbeeld uit de praktijk</Kicker>
      <h2 class="about-h2">Een patchkast die niemand begreep</h2>
      <blockquote class="about-case__quote">
        Een kleine onderneming, na de overname van een pand waarvan de vorige
        eigenaar de IT "even snel zelf had gedaan". Resultaat: een patchkast vol
        ongelabelde kabels, een netwerk dat niemand begreep, en bij elke storing
        de hoop dat je niet de verkeerde stekker uittrekt. Tien uur ter plaatse:
        alles in kaart gebracht, herbedraad, gelabeld en gedocumenteerd. Nu weet
        de eigenaar, en elke toekomstige IT'er, exact wat waar zit.
      </blockquote>
    </div>
  </section>

  {/* Eerste contact */}
  <section class="section band">
    <div class="container">
      <div class="section-head">
        <Kicker>Hoe een eerste contact eruitziet</Kicker>
        <h2>Drie stappen, zonder verkooppraat</h2>
      </div>
      <ol class="steps">
        {
          firstContact.map(([title, body], i) => (
            <li class="step">
              <span class="step__num">{i + 1}</span>
              <div>
                <h3 class="step__title">{title}</h3>
                <p class="step__body">{body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Waar werk ik */}
  <section class="section about-area">
    <div class="container">
      <Kicker color="var(--orange-300)">Waar werk ik</Kicker>
      <p class="about-area__text">
        Mijn thuisbasis is Jabbeke. Ik werk in Brugge, Oostende, Knokke-Heist,
        Blankenberge, Zedelgem, Oostkamp en de rest van West-Vlaanderen. Voor
        een afgebakend project reis ik ook verder.
      </p>
    </div>
  </section>

  {/* Feiten — plain, factual block (GEO: makes the core facts easy to extract) */}
  <section class="section band">
    <div class="container">
      <div class="section-head">
        <Kicker>Feiten</Kicker>
        <h2>Feiten over Packetflow</h2>
      </div>
      <dl class="facts">
        {
          facts.map((f) => (
            <div class="facts__row">
              <dt class="facts__term">{f.term}</dt>
              <dd class="facts__detail">
                {f.href ? <a href={f.href}>{f.detail}</a> : f.detail}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaSection />
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: var(--space-7);
    align-items: center;
  }
  .about-hero__intro {
    margin-top: var(--space-5);
    max-width: 56ch;
  }
  .about-hero__photo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }
  .about-portrait {
    width: 100%;
    max-width: 300px;
    aspect-ratio: 4 / 5;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  .about-hero__cap {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .about-h2 {
    font-size: var(--text-2xl);
    margin: var(--space-3) 0 var(--space-4);
  }
  .about-avail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: start;
  }
  .about-meaning__title {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: var(--fw-semibold);
    margin: 0 0 var(--space-4);
  }

  .about-work__grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .about-case {
    max-width: var(--container-md);
  }
  .about-case__quote {
    margin: var(--space-4) 0 0;
    padding: 0 0 0 var(--space-5);
    border: 0;
    border-left: 3px solid var(--orange-500);
    font-family: var(--font-sans);
    font-style: normal;
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.7;
    color: var(--text-body);
  }

  .about-area {
    background: var(--ink);
  }
  .about-area__text {
    margin-top: var(--space-4);
    max-width: 70ch;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--cream);
  }

  /* keep in sync with --container-md in global.css */
  @media (max-width: 880px) {
    .about-hero,
    .about-avail,
    .about-work__grid {
      grid-template-columns: 1fr;
    }
    .about-hero__photo {
      order: -1;
    }
  }
</style>
